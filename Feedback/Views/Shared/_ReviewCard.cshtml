@model Feedback.Models.Review

<a href="/Reviews/Details/@Model.Id" class="review-card-link">
    <div class="review-card">
        <div class="review-img-wrap">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="review-img" alt="@Model.ProductName" />
            }
            else
            {
                <div class="review-img-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>
                </div>
            }
        </div>
        <div class="review-body">
            <h5 class="review-title" title="@Model.ProductName">@Model.ProductName</h5>
            <div class="review-stars" aria-label="Rating: @Model.Rating out of 5">
                @for (int i = 1; i <= 5; i++)
                {
                    <span class="@(i <= Model.Rating ? "star filled" : "star")">★</span>
                }
            </div>
            <p class="review-text">@Model.Text</p>
            @if (!string.IsNullOrEmpty(Model.ExternalLink))
            {
                <span class="review-link">
                    View Product
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8L8 2M4 2h4v4" /></svg>
                </span>
            }
            <div class="review-footer">
                <div class="reviewer">
                    <div class="reviewer-avatar">
                        @{
                            var name = Model.User?.FullName ?? Model.User?.UserName ?? "A";
                            var initials = string.Concat(name.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                        }
                        <span>@initials</span>
                    </div>
                    <div class="reviewer-info">
                        <span class="reviewer-name">@(Model.User?.FullName ?? Model.User?.UserName ?? "Anonymous")</span>
                        <span class="reviewer-date">@Model.Date.ToString("MMM d, yyyy")</span>
                    </div>
                </div>
                <button class="like-btn"
                        data-id="@Model.Id"
                        data-liked="false"
                        aria-label="Like this review"
                        onclick="event.preventDefault(); event.stopPropagation();">
                    <span class="like-heart">♡</span>
                    <span class="like-count">@Model.Likes</span>
                </button>
            </div>
        </div>
    </div>
</a>
