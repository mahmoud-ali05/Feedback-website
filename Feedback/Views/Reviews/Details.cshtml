@model Feedback.Models.ReviewDetailViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<UsersApp.Models.Users> SignInManager

@{
    ViewData["Title"] = Model.Review.ProductName;
    var review = Model.Review;
    var name = review.User?.FullName ?? review.User?.UserName ?? "Anonymous";
    var initials = string.Concat(name.Split(' ').Take(2).Select(w => w[0])).ToUpper();
}

<style>
    .detail-wrap {
        max-width: 820px;
        margin: 0 auto;
    }

    /* ── Back link ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--muted, #64748b);
        text-decoration: none;
        margin-bottom: 28px;
        transition: color 0.15s;
    }
    .back-link:hover { color: var(--brand, #2563eb); }

    /* ── Hero card ── */
    .detail-card {
        background: rgba(255,255,255,0.93);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 40px rgba(0,0,0,0.13);
        margin-bottom: 32px;
    }

    .detail-img-wrap {
        width: 100%;
        height: 320px;
        overflow: hidden;
        position: relative;
    }
    .detail-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .detail-img-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #e0e7ff 0%, #fce7f3 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a5b4fc;
    }

    .detail-body {
        padding: 36px 40px 40px;
    }

    .detail-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .detail-stars {
        display: flex;
        gap: 3px;
    }
    .detail-stars .star { font-size: 20px; color: #d1d5db; }
    .detail-stars .star.filled { color: #fbbf24; }

    .detail-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(1.5rem, 4vw, 2.1rem);
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 20px;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .detail-text {
        font-size: 1rem;
        color: #374151;
        line-height: 1.85;
        margin: 0 0 28px;
    }

    .detail-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 24px;
        border-top: 1px solid #f1f5f9;
    }

    .reviewer {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .reviewer-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #dbeafe;
        color: #1d4ed8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }
    .reviewer-name {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
    }
    .reviewer-date {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 2px;
    }

    .detail-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #2563eb;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 9px 20px;
        border-radius: 10px;
        text-decoration: none;
        transition: background 0.15s, transform 0.1s;
    }
    .detail-link:hover {
        background: #1d4ed8;
        color: #fff;
        transform: translateY(-1px);
    }

    /* ── Comments section ── */
    .comments-section {
        background: rgba(255,255,255,0.93);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 20px;
        padding: 36px 40px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.10);
    }

    .comments-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 28px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .comments-count {
        font-family: 'Sora', sans-serif;
        font-size: 13px;
        font-weight: 600;
        background: #dbeafe;
        color: #1d4ed8;
        padding: 2px 10px;
        border-radius: 20px;
    }

    /* ── Comment form ── */
    .comment-form {
        margin-bottom: 36px;
        padding-bottom: 36px;
        border-bottom: 1px solid #f1f5f9;
    }
    .comment-form textarea {
        width: 100%;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 16px;
        font-family: 'Sora', sans-serif;
        font-size: 14px;
        color: #1e293b;
        resize: vertical;
        min-height: 100px;
        transition: border-color 0.15s, box-shadow 0.15s;
        background: #f8fafc;
    }
    .comment-form textarea:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.10);
        background: #fff;
    }
    .comment-form .btn-submit {
        margin-top: 12px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 24px;
        font-family: 'Sora', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
    }
    .comment-form .btn-submit:hover {
        background: #1d4ed8;
        transform: translateY(-1px);
    }
    .comment-form .login-prompt {
        font-size: 14px;
        color: #64748b;
        padding: 14px 16px;
        background: #f8fafc;
        border-radius: 12px;
        border: 1.5px dashed #e2e8f0;
    }
    .comment-form .login-prompt a {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
    }
    .comment-form .login-prompt a:hover { text-decoration: underline; }

    /* ── Comment list ── */
    .comment-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .comment-item {
        display: flex;
        gap: 14px;
    }

    .comment-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #dbeafe;
        color: #1d4ed8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .comment-bubble {
        flex: 1;
        background: #f8fafc;
        border-radius: 0 14px 14px 14px;
        padding: 14px 16px;
        border: 1px solid #f1f5f9;
    }

    .comment-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        flex-wrap: wrap;
    }
    .comment-author {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
    }
    .comment-date {
        font-size: 11.5px;
        color: #94a3b8;
    }
    .comment-text {
        font-size: 14px;
        color: #374151;
        line-height: 1.7;
        margin: 0;
    }

    .no-comments {
        text-align: center;
        color: #94a3b8;
        font-size: 14px;
        padding: 24px 0;
    }

    @@media (max-width: 600px) {
        .detail-body, .comments-section { padding: 24px 20px; }
        .detail-img-wrap { height: 220px; }
    }
</style>

<div class="detail-wrap">

    <!-- Back -->
    <a href="@Url.Action("Index", "Reviews")" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 12L6 8l4-4" /></svg>
        Back to reviews
    </a>

    <!-- ── Hero card ── -->
    <div class="detail-card">
        <div class="detail-img-wrap">
            @if (!string.IsNullOrEmpty(review.ImageUrl))
            {
                <img src="@review.ImageUrl" class="detail-img" alt="@review.ProductName" />
            }
            else
            {
                <div class="detail-img-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="3" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>
                </div>
            }
        </div>

        <div class="detail-body">
            <div class="detail-meta">
                <div class="detail-stars" aria-label="Rating: @review.Rating out of 5">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= review.Rating ? "star filled" : "star")">★</span>
                    }
                </div>
                <span style="font-size:13px;color:#94a3b8;">@review.Date.ToString("MMMM d, yyyy")</span>
            </div>

            <h1 class="detail-title">@review.ProductName</h1>
            <p class="detail-text">@review.Text</p>

            <div class="detail-footer">
                <div class="reviewer">
                    <div class="reviewer-avatar">@initials</div>
                    <div>
                        <div class="reviewer-name">@name</div>
                        <div class="reviewer-date">@review.Date.ToString("MMM d, yyyy")</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(review.ExternalLink))
                {
                    <a href="@review.ExternalLink" class="detail-link" target="_blank" rel="noopener noreferrer">
                        View Product
                        <svg width="12" height="12" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 8L8 2M4 2h4v4" /></svg>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- ── Comments section ── -->
    <div class="comments-section">
        <h2 class="comments-title">
            Comments
            <span class="comments-count">@review.Comments.Count</span>
        </h2>

        <!-- Comment form -->
        <div class="comment-form">
            @if (SignInManager.IsSignedIn(User))
            {
                <form asp-action="AddComment" asp-controller="Reviews" method="post">
                    <input type="hidden" name="ReviewId" value="@review.Id" />
                    <textarea name="Text"
                          placeholder="Share your thoughts about this review..."
                          maxlength="500">@Model.NewComment.Text</textarea>
                    <span asp-validation-for="NewComment.Text" class="text-danger" style="font-size:12px;"></span>
                    <br />
                    <button type="submit" class="btn-submit">Post Comment</button>
                </form>
            }
            else
            {
                <div class="login-prompt">
                    <a asp-controller="Account" asp-action="Login">Log in</a> to leave a comment.
                </div>
            }
        </div>

        <!-- Comment list -->
        <div class="comment-list">
            @if (!review.Comments.Any())
            {
                <div class="no-comments">No comments yet — be the first!</div>
            }
            else
            {
                @foreach (var comment in review.Comments.OrderByDescending(c => c.Id))
                {
                    var cName = comment.User?.FullName ?? comment.User?.UserName ?? "Anonymous";
                    var cInitials = string.Concat(cName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                    <div class="comment-item">
                        <div class="comment-avatar">@cInitials</div>
                        <div class="comment-bubble">
                            <div class="comment-header">
                                <span class="comment-author">@cName</span>
                            </div>
                            <p class="comment-text">@comment.Text</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</div>
