@model Review
<form asp-action="Create" method="post" enctype="multipart/form-data" class="ra-form-wrap">

    <p class="ra-form-title">Write a Review</p>
    <p class="ra-form-sub">Share your experience with a product</p>

    <div class="ra-field">
        <label class="ra-label" asp-for="ProductName">Product Name</label>
        <input asp-for="ProductName" class="ra-input" placeholder="e.g. Sony WH-1000XM5" />
        <span class="ra-error">@Html.ValidationMessageFor(m => m.ProductName)</span>
    </div>

    <div class="ra-field">
        <label class="ra-label" asp-for="Category">Product Category</label>
        <select asp-for="Category" class="ra-select">
            <option value="">Select Category</option>
            @if (ViewBag.Categories != null)
            {
                foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
        <span class="ra-error">@Html.ValidationMessageFor(m => m.Category)</span>
    </div>

    <div class="ra-field">
        <label class="ra-label" asp-for="Rating">Rating</label>
        <select asp-for="Rating" class="ra-select">
            <option value="">Select Rating</option>
            <option value="1">1 ★</option>
            <option value="2">2 ★★</option>
            <option value="3">3 ★★★</option>
            <option value="4">4 ★★★★</option>
            <option value="5">5 ★★★★★</option>
        </select>
        <span class="ra-error">@Html.ValidationMessageFor(m => m.Rating)</span>
    </div>

    <div class="ra-field">
        <label class="ra-label" asp-for="Text">Your Review</label>
        <textarea asp-for="Text" class="ra-textarea" placeholder="What did you think? Be honest!"></textarea>
        <span class="ra-error">@Html.ValidationMessageFor(m => m.Text)</span>
    </div>

    <div class="ra-field">
        <label class="ra-label">Product Image</label>
        <label class="ra-file-label">
            <span class="ra-file-icon">🖼</span>
            <span>Upload a photo (optional)</span>
            <input type="file" name="Image" accept="image/*" />
        </label>
    </div>

    <div class="ra-field">
        <label class="ra-label" asp-for="ExternalLink">Product Link</label>
        <input asp-for="ExternalLink" class="ra-input" placeholder="https://example.com/product" />
        <span class="ra-error">@Html.ValidationMessageFor(m => m.ExternalLink)</span>
    </div>

    <hr class="ra-divider" />
    <button type="submit" class="ra-submit">Submit Review</button>

</form>